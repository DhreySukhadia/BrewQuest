// BrewQuest Prisma Schema
// Database Target: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// BETTER AUTH CORE MODELS
// Required for Better Auth authentication setup
// ==========================================

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ExperienceTier {
  BEGINNER
  INTERMEDIATE
  EXPLORER
  ENTHUSIAST
}

model User {
  id             String         @id @default(cuid())
  name           String
  firstName      String
  lastName       String?
  username       String         @unique
  email          String         @unique
  emailVerified  Boolean        @default(false)
  image          String?
  profilePicture String?
  role           Role           @default(USER)
  status         AccountStatus  @default(ACTIVE)
  experienceTier ExperienceTier @default(BEGINNER)
  lastLoginAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sessions Session[]
  accounts Account[]

  addedCoffees     Coffee[] @relation("CoffeeAddedByAdmin")
  submittedCoffees Coffee[] @relation("CoffeeSubmittedByUser")
  reviewedCoffees  Coffee[] @relation("CoffeeReviewedByAdmin")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ==========================================
// BREWQUEST DOMAIN MODELS
// ==========================================

enum AttributeCategory {
  FLAVOR
  AROMA
  BODY
  ACIDITY
  SWEETNESS
  BITTERNESS
  FINISH
  OTHER
}

model Attribute {
  id          String            @id @default(cuid())
  name        String            @unique
  category    AttributeCategory
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  coffeeAttributes CoffeeAttribute[]

  @@index([category])
  @@map("attribute")
}

enum CoffeeSource {
  OFFICIAL
  COMMUNITY
  USER_CUSTOM
}

enum CoffeeReviewStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
  MERGED
}

model Roaster {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coffees Coffee[]

  @@map("roaster")
}

model Coffee {
  id   String @id @default(cuid())
  name String

  // Coffee information
  roasterId  String?
  roaster    Roaster? @relation(fields: [roasterId], references: [id])
  origin     String?
  region     String?
  farm       String?
  altitude   String?
  variety    String?
  processing String?
  roast      String?

  // Source and status
  source       CoffeeSource
  reviewStatus CoffeeReviewStatus

  // Confidence / moderation
  confidenceScore   Float?
  addedByAdminId    String?
  addedByAdmin      User?     @relation("CoffeeAddedByAdmin", fields: [addedByAdminId], references: [id])
  submittedByUserId String?
  submittedByUser   User?     @relation("CoffeeSubmittedByUser", fields: [submittedByUserId], references: [id])
  reviewedByAdminId String?
  reviewedByAdmin   User?     @relation("CoffeeReviewedByAdmin", fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?

  duplicateOfId String?
  duplicateOf   Coffee?  @relation("CoffeeDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    Coffee[] @relation("CoffeeDuplicates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coffeeAttributes CoffeeAttribute[]

  @@map("coffee")
}

model CoffeeAttribute {
  coffeeId    String
  attributeId String
  strength    Float?
  createdAt   DateTime @default(now())

  coffee    Coffee    @relation(fields: [coffeeId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([coffeeId, attributeId])
  @@map("coffee_attribute")
}
