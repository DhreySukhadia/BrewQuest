# ==========================================
# BREWQUEST ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting apps
# ==========================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brewquest?schema=public"

# Better Auth Secret (Generate using openssl rand -base64 32 or random string in production)
BETTER_AUTH_SECRET="brewquest_super_secret_key_change_me_in_production"
BETTER_AUTH_URL="http://localhost:3000"

# Application URLs & Ports
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT=4000
